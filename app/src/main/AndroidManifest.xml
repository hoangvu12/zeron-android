<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Custom Tabs (ui-parity#89 and #126): package visibility for
         CustomTabsClient.getPackageName on API 30+. Without it the PR chip's
         "Open Pull Request" and every transcript web link fall back to the
         plain VIEW intent / the external browser. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptics (parity #05): required by Vibrator.vibrate. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notifications + the run-watching foreground service (android-app#28).
         POST_NOTIFICATIONS is the API 33+ runtime permission (31–32 have none);
         POST_PROMOTED_NOTIFICATIONS is the API 36 Live Update permission
         (normal, no prompt). Exactly the ticket's list — no RECEIVE_BOOT_COMPLETED,
         no FCM/GMS. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- ADR 0010: "Stay connected in background" runs the same service as
         specialUse (API 34+, normal permission, no time limit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- #58: a few seconds of delivery after leaving right after Send (DeliveryService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <!-- #47 / SPEC D14: agent visuals' scenes and shaders render through
         Vulkan 1.1. Documentary and optional: without it the core falls
         back (software scenes, a shader's error state). -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="false" />
    <application
        android:name=".ZeronApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Zeron">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- zeron:// return URLs (#19, iOS Info.plist's one scheme). No
                 autoVerify: custom scheme. One filter: scheme × the hosts,
                 any path. `callback` is the WorkOS redirect when the browser
                 has no Auth Tab (#15), `signed-in` the provider/device
                 login's done page, `voice` the call notification (#61).
                 Notification taps are explicit intents, not links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zeron" />
                <data android:host="callback" />
                <data android:host="signed-in" />
                <data android:host="voice" />
            </intent-filter>
        </activity>
        <!-- android-app#28 + ADR 0010: the run-watching foreground service.
             dataSync while a run is Working (and for the 2 min linger after
             it) with notifications on; specialUse while the opt-in "Stay
             connected in background" setting holds it (dataSync is
             time-limited on API 35+, specialUse is not). Never started from
             the background, never at boot. The subtype property is the
             justification Play would review; Zeron ships no Play build. -->
        <service
            android:name=".background.RunWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Opt-in setting: keeps the user's own paired engine connections (self-hosted coding-agent desktop, LAN or tunnel WebSocket) open while the app is in the background, so run status and completion notifications arrive live. No push service exists (no FCM by design)." />
        </service>
        <!-- #58: the delivery hold, 25 s after backgrounding right after a
             send. shortService on API 34+ (no budget), dataSync below. -->
        <service
            android:name=".background.DeliveryService"
            android:exported="false"
            android:foregroundServiceType="shortService|dataSync" />
        <!-- android-ui-parity #87: the attach menu's camera capture file. No
             uses-permission CAMERA and no uses-feature camera: the capture
             intent needs neither, and a required feature would hide the app
             from camera-less devices. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

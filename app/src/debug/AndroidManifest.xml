<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The debug-only design gallery (android-ui-parity #22). No intent
             filter, so it gets no launcher icon; exported because
             `adb shell am start -n` runs as the shell uid and cannot start a
             non-exported activity. Release builds merge no such activity:
             this manifest (and the class) exist only in src/debug. -->
        <activity
            android:name=".design.DesignGalleryActivity"
            android:exported="true"
            android:label="Design Gallery"
            android:windowSoftInputMode="adjustResize" />
        <!-- The debug-only Transcript Lab (android-ui-parity #135), the -lab
             port: the real transcript over the Rust fixture, no engine, no
             shell. Same rules as the gallery above — exported for
             `adb shell am start -n`, no intent filter, so no launcher icon;
             release builds merge no such activity. adjustResize plus
             edge-to-edge is required for WindowInsets.ime to animate per
             frame (ticket 74's pitfall); the configChanges list keeps the
             activity (and a live stream) alive through rotation and
             dark-mode changes, while fontScale/density changes reach the
             host through recomposition without recreating the engine. -->
        <activity
            android:name=".debug.TranscriptLabActivity"
            android:exported="true"
            android:label="Transcript Lab"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale" />
        <!-- The debug-only Component Lab (#12, input for decision D7 / #1):
             each hand-built component three ways (Roboco custom, our look on
             headless primitives, stock Material 3). Unlike the two above it
             has a launcher entry, so the owner can open it on a phone while
             signed out (the app always lands on the Welcome placeholder);
             its own task affinity keeps it out of the app's task. Release
             builds merge no such activity: this manifest exists only in
             src/debug. -->
        <activity
            android:name=".design.lab.ComponentLabActivity"
            android:exported="true"
            android:label="Component Lab"
            android:taskAffinity="sh.zeron.android.componentlab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

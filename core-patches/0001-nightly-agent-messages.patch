+    starts.extend(text.match_indices(&format!("\n\n{REPORT_PREFIX}")).map(|(at, _)| at + 2));
+    let blocks: Vec<&str> = starts
+        .iter()
+        .enumerate()
+        .map(|(i, &start)| &text[start..starts.get(i + 1).map_or(text.len(), |next| next - 2)])
+        .collect();
+    (blocks.len() == reports.len()).then_some(blocks)

+/// bytes, nothing left out: each part keeps its header and says which part
+/// it is. A report that fits is itself, alone.
+pub fn split_report(report: &str, budget: usize) -> Vec<String> {
+    if report.len() <= budget {
+        return vec![report.to_owned()];
+    }
+    let Some((header, body)) = report.split_once("]\n\n") else {
+        return vec![report.to_owned()];
+    };
+    let room = budget.saturating_sub(header.len() + 64).max(1024);
+    let mut chunks = Vec::new();
+    let mut rest = body;
+    while !rest.is_empty() {
+        let mut end = room.min(rest.len());
+        while !rest.is_char_boundary(end) {
+            end -= 1;
+        }
+        chunks.push(&rest[..end]);
+        rest = &rest[end..];
+    }
+    let n = chunks.len();
+    chunks
+        .iter()
+        .enumerate()
+        .map(|(i, chunk)| format!("{header}]\n\n(Part {} of {n} of this message.)\n\n{chunk}", i + 1))
+        .collect()
+}
